{
  "name": "upwise",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm --prefix server run dev",
    "server:start": "npm --prefix server run start",
    "server:build": "npm --prefix server run build",
    "build": "tsc && vite build",
    "build:all": "npm --prefix server run build && tsc && vite build",
    "preview": "vite preview",
    "test": "node server/node_modules/tsx/dist/cli.mjs --test src/tests/*.test.ts",
    "test:server": "npm --prefix server test",
    "test:all": "npm test && npm run test:server"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "maplibre-gl": "^6.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "vite": "^6.0.5"
  }
}
